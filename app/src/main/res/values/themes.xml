<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lor" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/lor_bg</item>
        <item name="android:colorAccent">@color/lor_accent</item>
        <item name="android:colorPrimary">@color/lor_ink</item>
    </style>
    <style name="Theme.Lor.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lor_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Lor</item>
    </style>
</resources>
